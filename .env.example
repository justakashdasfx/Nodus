# Copy to .env.local for `vercel dev`. On Vercel, set these in Project → Settings → Environment Variables.

# The key you type once on each device. Make it long and random.
SYNC_KEY=change-me

# From your Upstash Redis database (Vercel Marketplace → Upstash → Redis).
# The Vercel integration may name these KV_REST_API_URL / KV_REST_API_TOKEN instead — both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
